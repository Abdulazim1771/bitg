:80 {
	root * /srv
	encode zstd gzip

	# deploy.sh css/js/wasm manzillariga ?v=<sha> qo'shadi — uzoq kesh xavfsiz
	@code path /*.js /*.css /*.wasm /fonts/*
	header @code Cache-Control "public, max-age=31536000, immutable"

	@meta path /icon.svg /og.png /robots.txt /sitemap.xml
	header @meta Cache-Control "public, max-age=86400"

	@dl path /download/*
	header @dl {
		Cache-Control "public, max-age=3600"
		Content-Disposition attachment
	}

	@html path / /index.html /version.txt
	header @html Cache-Control "no-cache"

	header {
		# 'wasm-unsafe-eval' — sinov maydoni bitg yadrosini WebAssembly sifatida ishga tushiradi
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	file_server

	handle_errors 404 {
		redir * / 302
	}
